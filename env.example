# ========================================
# Environment Variables Template
# Copy this file to .env and fill in your values
# ========================================

# Database Configuration
POSTGRES_USER=pienskerst
POSTGRES_PASSWORD=change_this_secure_password
POSTGRES_DB=kerstfilms
DATABASE_URL=postgresql://pienskerst:change_this_secure_password@db:5432/kerstfilms

# Backend Configuration
SECRET_KEY=change_this_to_a_random_secret_key_at_least_32_chars_long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# TMDB API (get your key at https://www.themoviedb.org/settings/api)
TMDB_API_KEY=your_tmdb_api_key_here

# Admin User (created on first run)
ADMIN_EMAIL=pien@kerstfilms.nl
ADMIN_PASSWORD=change_this_admin_password

# Environment
ENVIRONMENT=development

# CORS (for development - add your production domain for production)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Frontend (for production build - change to your domain)
VITE_API_URL=http://localhost:8000

# ========================================
# PRODUCTION NOTES:
# ========================================
# 1. Generate secure SECRET_KEY:
#    python3 -c "import secrets; print(secrets.token_urlsafe(32))"
#
# 2. Use strong passwords for:
#    - POSTGRES_PASSWORD
#    - ADMIN_PASSWORD
#
# 3. Get TMDB API key:
#    https://www.themoviedb.org/settings/api
#
# 4. For production, update:
#    - CORS_ORIGINS to include your domain
#    - VITE_API_URL to your domain
#    - ENVIRONMENT=production

